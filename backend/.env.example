# Synaps backend settings. Copy to backend/.env and uncomment what you need.
# Every value is optional: the defaults reproduce the original single-user setup.
# Real environment variables (e.g. from the systemd unit) win over this file.

# ── Storage & database ─────────────────────────────────────────────────────
# Media root holding Vault/, Mirrors/, Imports/ and .synaps_tmp/ (default: ../mock_storage)
# SYNAPS_STORAGE_PATH=/storage
# SYNAPS_DB_URL=sqlite:////home/harsh/nas_dashboard/backend/synaps.db
# SYNAPS_THUMBNAIL_DIR=/home/harsh/nas_dashboard/backend/thumbnails
# SYNAPS_TRASH_DIR=/home/harsh/nas_dashboard/backend/trash
# SYNAPS_SQLITE_BUSY_TIMEOUT_MS=30000

# ── Server ─────────────────────────────────────────────────────────────────
# SYNAPS_HOST=0.0.0.0
# SYNAPS_PORT=8000

# ── Per-person folders ─────────────────────────────────────────────────────
# Owner name in Vault/<Owner>/Iphone, Imports/<owner>/Iphone and Mirrors/<Owner>/{Mac,Iphone,...}
# SYNAPS_OWNER_NAME=Harsh
# SYNAPS_MIRROR_OWNER=Harsh
# Or set the individual folders directly:
# SYNAPS_SYNC_TARGET_DIR=/storage/Vault/Harsh/Iphone
# SYNAPS_IMPORT_SOURCE_DIR=/storage/Imports/harsh/Iphone
# SYNAPS_IMPORT_DEST_DIR=/storage/Vault/Harsh/Iphone
# Extra folders the scanner skips, relative to SYNAPS_STORAGE_PATH, comma-separated.
# (Mirrors and .synaps_tmp are always skipped.)
# SYNAPS_EXCLUDED_PATHS=Vault/Old_Backups,Scratch

# ── Security ───────────────────────────────────────────────────────────────
# Shared API token for every /api/* request (empty = no auth). /api/health and /health stay open.
# Clients send it as "Authorization: Bearer <token>", cookie synaps_token=<token> or ?token=<token>.
# Use a cookie-safe value, e.g.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# SYNAPS_API_TOKEN=

# Browser origins allowed to call the API with credentials. The web app is same-origin except
# for direct uploads from the `next start` dashboard (:3000) to :8000. Default: port 3000 on
# localhost, 127.x, 10.x, 172.16-31.x, 192.168.x, Tailscale 100.64/10 and *.local names.
# Setting this REPLACES the default (comma-separated exact origins; "*" = any site, but then
# without cookies/credentials):
# SYNAPS_CORS_ORIGINS=http://192.168.0.105:3000,https://nas.example.ts.net
# Or allow origins by pattern (a Python regex matched against the whole origin; empty = none):
# SYNAPS_CORS_ORIGIN_REGEX=

# ── Web app ────────────────────────────────────────────────────────────────
# Serve the web app's static export (cd frontend && npm run build:static -> frontend/out) from the
# backend at "/", so the Node.js server isn't needed. Ignored if the folder doesn't exist.
# update.sh then builds with build:static and leaves synaps-frontend alone.
# SYNAPS_FRONTEND_DIST=/home/harsh/nas_dashboard/frontend/out

# ── Thumbnails & previews ──────────────────────────────────────────────────
# Background thumbnail threads (1 leaves the second Core 2 Duo core to the web server and SQLite)
# SYNAPS_THUMBNAIL_WORKERS=1
# Max queued thumbnail jobs; the oldest are dropped beyond this (re-queued when viewed again)
# SYNAPS_THUMBNAIL_QUEUE_MAX=2000
# Disk cache for full-size JPEG previews of HEIC photos, in MB
# SYNAPS_PREVIEW_CACHE_MB=1024

# ── Uploads ────────────────────────────────────────────────────────────────
# Refuse a streamed upload that would leave less free disk space than this (bytes; 512 MiB)
# SYNAPS_MIN_FREE_BYTES=536870912
