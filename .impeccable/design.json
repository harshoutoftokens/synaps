  "components": [
    {
      "name": "Small Tile",
      "kind": "card",
      "refersTo": "tile",
      "description": "A 1x1 widget: label with icon, one big rounded tabular figure at the bottom, a caption.",
      "html": "<section class=\"ds-tile\" tabindex=\"0\"><h2 class=\"ds-label\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"4\" y=\"4\" width=\"16\" height=\"16\" rx=\"2\"/><rect x=\"9\" y=\"9\" width=\"6\" height=\"6\" rx=\"1\"/><path d=\"M15 2v2M15 20v2M2 15h2M2 9h2M20 15h2M20 9h2M9 2v2M9 20v2\"/></svg>CPU</h2><div class=\"ds-figure\">23<span class=\"ds-unit\">%</span></div><p class=\"ds-caption\">Load 0.42 · 2 cores</p></section>",
      "css": ".ds-tile{width:200px;height:168px;display:flex;flex-direction:column;padding:16px 18px;border-radius:22px;background:var(--w-tile,#1d1f21);color:var(--w-text,#f2f2f7);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',system-ui,sans-serif;overflow:hidden;transition:background-color .6s cubic-bezier(.16,1,.3,1)}.ds-label{display:flex;align-items:center;gap:6px;margin:0;font-size:13px;font-weight:600;color:var(--w-text-2,#aeaeb2)}.ds-figure{margin-top:auto;font-family:ui-rounded,-apple-system,BlinkMacSystemFont,'SF Pro Rounded',system-ui,sans-serif;font-size:44px;font-weight:600;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-unit{margin-left:3px;font-size:20px;letter-spacing:0;color:var(--w-text-2,#aeaeb2)}.ds-caption{margin:4px 0 0;font-size:13px;line-height:1.35;color:var(--w-text-2,#aeaeb2);font-variant-numeric:tabular-nums}.ds-tile:focus-visible{outline:2px solid var(--w-blue-fill,#0a84ff);outline-offset:2px}"
    },
    {
      "name": "Needs Attention Tile (warning)",
      "kind": "card",
      "refersTo": "tile-warn",
      "description": "The one tile whose whole background changes with state; amber for attention, red for critical.",
      "html": "<section class=\"ds-tile ds-tile-wide ds-warn\" tabindex=\"0\"><h2 class=\"ds-label\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>Needs attention</h2><ul class=\"ds-problems\"><li>Disk is 90% full: 23.2 GB left.</li><li>Mom's iPhone hasn't backed up in 9 days.</li></ul></section>",
      "css": ".ds-tile{width:200px;height:168px;display:flex;flex-direction:column;padding:16px 18px;border-radius:22px;background:var(--w-tile,#1d1f21);color:var(--w-text,#f2f2f7);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',system-ui,sans-serif;overflow:hidden;transition:background-color .6s cubic-bezier(.16,1,.3,1)}.ds-label{display:flex;align-items:center;gap:6px;margin:0;font-size:13px;font-weight:600;color:var(--w-text-2,#aeaeb2)}.ds-figure{margin-top:auto;font-family:ui-rounded,-apple-system,BlinkMacSystemFont,'SF Pro Rounded',system-ui,sans-serif;font-size:44px;font-weight:600;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-unit{margin-left:3px;font-size:20px;letter-spacing:0;color:var(--w-text-2,#aeaeb2)}.ds-caption{margin:4px 0 0;font-size:13px;line-height:1.35;color:var(--w-text-2,#aeaeb2);font-variant-numeric:tabular-nums}.ds-tile:focus-visible{outline:2px solid var(--w-blue-fill,#0a84ff);outline-offset:2px}.ds-tile-wide{width:416px}.ds-warn{background:var(--w-amber-tile,#33260f)}.ds-warn .ds-label{color:var(--w-amber,#ffb340)}.ds-problems{margin:auto 0 0;padding:0;list-style:none;font-size:15px;font-weight:600;line-height:1.375}"
    },
    {
      "name": "Needs Attention Tile (critical)",
      "kind": "card",
      "refersTo": "tile-crit",
      "description": "Critical state: the NAS is unreachable or the disk is at 95% or more.",
      "html": "<section class=\"ds-tile ds-tile-wide ds-crit\" tabindex=\"0\"><h2 class=\"ds-label\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3\"/><path d=\"M12 9v4\"/><path d=\"M12 17h.01\"/></svg>Needs attention</h2><p class=\"ds-statement\">Can't reach the NAS. Check that it's on and connected.</p></section>",
      "css": ".ds-tile{width:200px;height:168px;display:flex;flex-direction:column;padding:16px 18px;border-radius:22px;background:var(--w-tile,#1d1f21);color:var(--w-text,#f2f2f7);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Segoe UI',system-ui,sans-serif;overflow:hidden;transition:background-color .6s cubic-bezier(.16,1,.3,1)}.ds-label{display:flex;align-items:center;gap:6px;margin:0;font-size:13px;font-weight:600;color:var(--w-text-2,#aeaeb2)}.ds-figure{margin-top:auto;font-family:ui-rounded,-apple-system,BlinkMacSystemFont,'SF Pro Rounded',system-ui,sans-serif;font-size:44px;font-weight:600;line-height:1;letter-spacing:-.02em;font-variant-numeric:tabular-nums}.ds-unit{margin-left:3px;font-size:20px;letter-spacing:0;color:var(--w-text-2,#aeaeb2)}.ds-caption{margin:4px 0 0;font-size:13px;line-height:1.35;color:var(--w-text-2,#aeaeb2);font-variant-numeric:tabular-nums}.ds-tile:focus-visible{outline:2px solid var(--w-blue-fill,#0a84ff);outline-offset:2px}.ds-tile-wide{width:416px}.ds-crit{background:var(--w-red-tile,#3a1714)}.ds-crit .ds-label{color:var(--w-red,#ff6961)}.ds-statement{margin:auto 0 0;font-size:17px;font-weight:600;line-height:1.375}"
    },
