# ========================
# Synaps .gitignore
# ========================

# 1. Source Code Dependencies & Environments
node_modules/
backend/venv/
env/
venv/
.env
.env.*
!.env.example

# 2. Python Cache & Build
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg

# 3. Next.js Build & Cache
.next/
out/
next-env.d.ts
*.tsbuildinfo

# 4. Database & Indexes
*.db
*.sqlite
*.sqlite3
*.db-journal

# 5. Media, Uploads, Thumbnails & Cache
mock_storage/
iphone/
backend/thumbnails/
backend/trash/
uploaded_media/
thumbnails/
trash/
cache/
.cache/

# 6. Logs, Reports & Temp Files
*.log
logs/
tmp/
temp/
.tmp/
*.tmp
*.swp
*.swo
*~
*.report.json
duplicates_report.txt

# 7. Security, Credentials & Personal Migration Scripts
*.pem
*.key
*.pub
id_*
setup_ssh*.py
test_scp.py
verify_nas.py
sync_*.py
detect_origin.py
private/
personal/

# 8. IDE & OS Files
.vscode/
.idea/
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# 9. Swift, Xcode & macOS Client Builds
.build/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
*.xcuserstate
xcuserdata/
DerivedData/
*.app/
checkpoints/

