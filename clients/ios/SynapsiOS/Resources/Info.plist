	<string>Synaps accesses your photo library to display photos, indicate vault commit status with green ticks and red crosses, and sync your media with your Synaps NAS.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
